# Database (relative to prisma/schema.prisma for SQLite)
DATABASE_URL="file:../db/custom.db"

# Required: minimum 32-character random secret for signing session & CSRF tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-char-random-hex-secret"

# Required for Google OAuth sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to <request-origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# Public site origin (used for OAuth redirects, CORS, and Caddy TLS)
APP_URL="https://localhost"
SITE_ADDRESS="localhost"
ALLOWED_ORIGINS="https://localhost,http://localhost:3000"

# Chat WebSocket service
NEXT_PUBLIC_CHAT_URL=""
CHAT_MAIN_DB_PATH="./db/custom.db"

# Development-only demo account switcher (strictly disabled in production)
ENABLE_DEV_DEMO_AUTH="false"

